{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AOC",
  "version": "0.1.0",
  "identifier": "ai.aoc.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AOC · 模拟飞行运行中心",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720,
        "visible": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "AOC",
    "copyright": "AOC",
    "category": "Utility",
    "shortDescription": "AOC 模拟飞行运行中心（个人模式）",
    "longDescription": "记录 MSFS 飞行、生成航路、回放轨迹与落地评估的个人飞行助理。",
    "resources": {
      "../dist": "client",
      "../../../packages": "packages",
      "../../../data": "data",
      "../../../apps/aoc-core": "aoc-core",
      "../../../apps/simlink/bin/Release/net8.0/win-x64": "simlink"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
