{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AOC Map Probe",
  "version": "0.1.0",
  "identifier": "ai.aoc.map-probe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AOC 轨迹回放探针",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "AOC",
    "copyright": "AOC M0 probe",
    "category": "Utility",
    "shortDescription": "AOC 轨迹回放探针",
    "longDescription": "M0 技术验证用离线轨迹回放器：单条 LineString 增量 setData 回放 1 万点，用于验证 Tauri + MapLibre 渲染与体积预算。",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
