# cp deploy/.env.example deploy/.env 后修改
POSTGRES_DB=aoc
POSTGRES_USER=aoc
POSTGRES_PASSWORD=change-me-db-password

# 32 字节以上随机串：python -c "import secrets;print(secrets.token_urlsafe(48))"
AOC_SECRET=change-me-session-secret

AOC_BOOTSTRAP_COMPANY=AOC Virtual
AOC_BOOTSTRAP_ICAO=AOC
AOC_BOOTSTRAP_CALLSIGN=AOC
AOC_BOOTSTRAP_BASE=ZBAA
AOC_BOOTSTRAP_ADMIN=admin
AOC_BOOTSTRAP_PASSWORD=change-me-admin-password

# 首次启动是否写入演示机队/航线（生产建议 0）
AOC_SEED_DEMO=0
# 公网 HTTPS 必须 1；本机 http 快速验证用 0
AOC_COOKIE_SECURE=0
# 前后端分离部署时的管理端来源；同域部署保留默认（桌面客户端需要 tauri 来源）
AOC_CORS_ORIGINS=https://aoc.example.com,tauri://localhost,https://tauri.localhost
AOC_PORT=8080
